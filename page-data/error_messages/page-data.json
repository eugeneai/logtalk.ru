ldren":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"аргументы вызова;"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"порядок предложений;"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"не забыли ли вы про отсечение или проверку типа."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"как-читать-сообщения-компилятора","style":"position:relative;"},"children":[{"type":"text","value":"Как читать сообщения компилятора"},{"type":"element","tagName":"a","properties":{"href":"#%D0%BA%D0%B0%D0%BA-%D1%87%D0%B8%D1%82%D0%B0%D1%82%D1%8C-%D1%81%D0%BE%D0%BE%D0%B1%D1%89%D0%B5%D0%BD%D0%B8%D1%8F-%D0%BA%D0%BE%D0%BC%D0%BF%D0%B8%D0%BB%D1%8F%D1%82%D0%BE%D1%80%D0%B0","ariaLabel":"как читать сообщения компилятора permalink","className":["anchor","after"]},"children":[{"type":"element","tagName":"svg","properties":{"ariaHidden":"true","focusable":"false","height":"16","version":"1.1","viewBox":"0 0 16 16","width":"16"},"children":[{"type":"element","tagName":"path","properties":{"fillRule":"evenodd","d":"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"},"children":[]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["language-text"]},"children":[{"type":"text","value":"!"}]},{"type":"text","value":" — ошибка, файл не загружен;"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["language-text"]},"children":[{"type":"text","value":"*"}]},{"type":"text","value":" — предупреждение, файл обычно загружен;"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["language-text"]},"children":[{"type":"text","value":"%"}]},{"type":"text","value":" — информационное сообщение."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Подключите инструмент "},{"type":"element","tagName":"code","properties":{"className":["language-text"]},"children":[{"type":"text","value":"tutor"}]},{"type":"text","value":", чтобы получать пояснения к сообщениям:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":["gatsby-highlight"],"dataLanguage":"logtalk"},"children":[{"type":"element","tagName":"pre","properties":{"className":["language-logtalk"]},"children":[{"type":"element","tagName":"code","properties":{"className":["language-logtalk"]},"children":[{"type":"element","tagName":"span","properties":{"className":["token","operator"]},"children":[{"type":"text","value":"?-"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["token","function"]},"children":[{"type":"text","value":"logtalk_load"}]},{"type":"element","tagName":"span","properties":{"className":["token","punctuation"]},"children":[{"type":"text","value":"("}]},{"type":"element","tagName":"span","properties":{"className":["token","function"]},"children":[{"type":"text","value":"tutor"}]},{"type":"element","tagName":"span","properties":{"className":["token","punctuation"]},"children":[{"type":"text","value":"("}]},{"type":"text","value":"loader"},{"type":"element","tagName":"span","properties":{"className":["token","punctuation"]},"children":[{"type":"text","value":")"}]},{"type":"element","tagName":"span","properties":{"className":["token","punctuation"]},"children":[{"type":"text","value":")"}]},{"type":"element","tagName":"span","properties":{"className":["token","operator"]},"children":[{"type":"text","value":"."}]}]}]}]}],"data":{"quirksMode":false}},"html":"<p>На этой странице собраны типичные сообщения Logtalk и способы их исправить.</p>\n<h2 id=\"existence-error-procedure--does-not-exist\" style=\"position:relative;\">Existence error: procedure ... does not exist<a href=\"#existence-error-procedure--does-not-exist\" aria-label=\"existence error procedure  does not exist permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Объект получил сообщение, для которого нет объявленного публичного предиката.</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">?-</span> counter<span class=\"token operator\">::</span><span class=\"token function\">value</span><span class=\"token punctuation\">(</span>Value<span class=\"token punctuation\">)</span><span class=\"token operator\">.</span>\n<span class=\"token operator\">!</span>     Existence error<span class=\"token operator\">:</span> procedure <span class=\"token function\">value/1</span> does <span class=\"token operator\">not</span> exist</code></pre></div>\n<p>Проверьте:</p>\n<ul>\n<li>объявлен ли предикат директивой <code class=\"language-text\">:- public(value/1).</code>;</li>\n<li>загружен ли объект, которому отправляется сообщение;</li>\n<li>не перепутаны ли имя и арность.</li>\n</ul>\n<h2 id=\"unknown-message\" style=\"position:relative;\">Unknown message<a href=\"#unknown-message\" aria-label=\"unknown message permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Сообщение отправлено объекту, но такой предикат не входит в его протокол:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">?-</span> counter<span class=\"token operator\">::</span><span class=\"token function\">unknown</span><span class=\"token punctuation\">(</span>Value<span class=\"token punctuation\">)</span><span class=\"token operator\">.</span></code></pre></div>\n<p>В отличие от ошибки existence error, это может быть предупреждение компилятора, если вызов известен на этапе компиляции. Проверьте имя метода и область видимости.</p>\n<h2 id=\"singleton-variable\" style=\"position:relative;\">Singleton variable<a href=\"#singleton-variable\" aria-label=\"singleton variable permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Компилятор предупреждает об одноразовой переменной:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">*</span>     Singleton variable<span class=\"token operator\">:</span> Name</code></pre></div>\n<p>Если переменная действительно не нужна, замените её на <code class=\"language-text\">_</code> или <code class=\"language-text\">_Name</code>. Если нужна — проверьте, не забыли ли вы использовать её в теле правила.</p>\n<h2 id=\"undefined-predicate\" style=\"position:relative;\">Undefined predicate<a href=\"#undefined-predicate\" aria-label=\"undefined predicate permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Предикат объявлен, но не определён:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">*</span>     Declared static predicate called but <span class=\"token operator\">not</span> defined<span class=\"token operator\">:</span> <span class=\"token function\">value/1</span></code></pre></div>\n<p>Добавьте предложения для предиката или удалите объявление. Для динамических предикатов проверьте директиву <code class=\"language-text\">:- dynamic(value/1).</code>.</p>\n<h2 id=\"type-error--domain-error\" style=\"position:relative;\">Type error / domain error<a href=\"#type-error--domain-error\" aria-label=\"type error  domain error permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Аргумент имеет неверный тип или недопустимое значение:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">!</span>     Type error<span class=\"token operator\">:</span> expected integer but got hello</code></pre></div>\n<p>Проверьте порядок аргументов и используйте проверки <code class=\"language-text\">integer/1</code>, <code class=\"language-text\">atom/1</code>, <code class=\"language-text\">is_list/1</code> перед вызовом.</p>\n<h2 id=\"syntax-error\" style=\"position:relative;\">Syntax error<a href=\"#syntax-error\" aria-label=\"syntax error permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Чаще всего причина — пропущенная точка в конце предложения или несбалансированная скобка:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">:-</span> <span class=\"token superscript_keywords\">object</span><span class=\"token punctuation\">(</span>example<span class=\"token punctuation\">)</span><span class=\"token operator\">.</span>\n    <span class=\"token operator\">:-</span> <span class=\"token superscript_keywords\">public</span><span class=\"token punctuation\">(</span><span class=\"token function\">foo/1</span><span class=\"token punctuation\">)</span><span class=\"token operator\">.</span>\n    <span class=\"token function\">foo</span><span class=\"token punctuation\">(</span>X<span class=\"token punctuation\">)</span> <span class=\"token operator\">:-</span> X <span class=\"token operator\">=</span> <span class=\"token number\">1</span>    <span class=\"token comment\">% пропущена точка</span>\n<span class=\"token operator\">:-</span> <span class=\"token superscript_keywords\">end_object</span><span class=\"token operator\">.</span></code></pre></div>\n<p>Компилятор указывает файл и строку. Если строка выглядит правильно, проверьте строку выше.</p>\n<h2 id=\"dynamic-predicate-not-declared\" style=\"position:relative;\">Dynamic predicate not declared<a href=\"#dynamic-predicate-not-declared\" aria-label=\"dynamic predicate not declared permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>При добавлении факта через <code class=\"language-text\">assertz/1</code> предикат должен быть динамическим:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">:-</span> <span class=\"token superscript_keywords\">private</span><span class=\"token punctuation\">(</span><span class=\"token function\">count_/1</span><span class=\"token punctuation\">)</span><span class=\"token operator\">.</span>\n<span class=\"token operator\">:-</span> <span class=\"token superscript_keywords\">dynamic</span><span class=\"token punctuation\">(</span><span class=\"token function\">count_/1</span><span class=\"token punctuation\">)</span><span class=\"token operator\">.</span></code></pre></div>\n<p>Без директивы <code class=\"language-text\">dynamic/1</code> обновление может завершиться ошибкой или предупреждением.</p>\n<h2 id=\"сообщение-no-matching-clause-for-goal\" style=\"position:relative;\">Сообщение «No matching clause for goal»<a href=\"#%D1%81%D0%BE%D0%BE%D0%B1%D1%89%D0%B5%D0%BD%D0%B8%D0%B5-no-matching-clause-for-goal\" aria-label=\"сообщение no matching clause for goal permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<p>Локальный предикат вызван, но ни одно предложение не подошло. Проверьте:</p>\n<ul>\n<li>аргументы вызова;</li>\n<li>порядок предложений;</li>\n<li>не забыли ли вы про отсечение или проверку типа.</li>\n</ul>\n<h2 id=\"как-читать-сообщения-компилятора\" style=\"position:relative;\">Как читать сообщения компилятора<a href=\"#%D0%BA%D0%B0%D0%BA-%D1%87%D0%B8%D1%82%D0%B0%D1%82%D1%8C-%D1%81%D0%BE%D0%BE%D0%B1%D1%89%D0%B5%D0%BD%D0%B8%D1%8F-%D0%BA%D0%BE%D0%BC%D0%BF%D0%B8%D0%BB%D1%8F%D1%82%D0%BE%D1%80%D0%B0\" aria-label=\"как читать сообщения компилятора permalink\" class=\"anchor after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h2>\n<ul>\n<li><code class=\"language-text\">!</code> — ошибка, файл не загружен;</li>\n<li><code class=\"language-text\">*</code> — предупреждение, файл обычно загружен;</li>\n<li><code class=\"language-text\">%</code> — информационное сообщение.</li>\n</ul>\n<p>Подключите инструмент <code class=\"language-text\">tutor</code>, чтобы получать пояснения к сообщениям:</p>\n<div class=\"gatsby-highlight\" data-language=\"logtalk\"><pre class=\"language-logtalk\"><code class=\"language-logtalk\"><span class=\"token operator\">?-</span> <span class=\"token function\">logtalk_load</span><span class=\"token punctuation\">(</span><span class=\"token function\">tutor</span><span class=\"token punctuation\">(</span>loader<span class=\"token punctuation\">)</span><span class=\"token punctuation\">)</span><span class=\"token operator\">.</span></code></pre></div>","frontmatter":{"path":"/error_messages","title":"Наиболее часто возникающие ошибки","banner":null},"fileAbsolutePath":"/srv/http/logtalk.ru/.build-test/data/error_messages.md"}},"pageContext":{"mdPath":"/error_messages"}},"staticQueryHashes":["1357757885","994120085"],"slicesMap":{}}